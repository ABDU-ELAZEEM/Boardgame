pipeline {
    agent any
     tools {
         maven 'My-Mavan'
     }
    stages {

        stage('comile') {
            steps {
                sh 'mvn compile'
            }
        }
        stage('Tests') {
            steps {
                sh 'mvn test'
            }
        }
        stage('package') {
            steps {
                sh 'mvn package'
            }
        }

    }
}
